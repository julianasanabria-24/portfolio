---
import Base from '../layouts/Base.astro';
import info from '../data/info.json';

const experiments = info.playground;
---

<Base title="Playground" description="Experimentos, bocetos y pruebas.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">en construcción permanente</span>
      <h1>Playground</h1>
      <p class="muted intro">Un espacio para experimentar con nuevas herramientas y formas de crear.</p>

      <ul class="board">
        {
          experiments.map((x, i) => (
            <li class="note tape reveal" style={`background:${x.color}; rotate:${[-3, 2, -1, 3, -2, 1][i % 6]}deg`}>
              <span class="tag">{x.tag}</span>
              <h2>{x.title}</h2>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .section {
    padding-top: 9rem;
  }
  .intro {
    max-width: 40ch;
    font-size: 1.2rem;
  }
  .board {
    list-style: none;
    padding: 0;
    margin: 4rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 2.5rem;
  }
  .note {
    aspect-ratio: 1;
    padding: 1.5rem;
    color: var(--navy);
    border: 2px solid var(--navy);
    box-shadow: 5px 5px 0 var(--navy);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .tag {
    font-family: var(--font-hand);
    font-size: 0.85rem;
  }
  h2 {
    font-size: 2rem;
    margin: 0;
  }
</style>
