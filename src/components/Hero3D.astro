---
// Ramo de flores 3D estilo "clay". Al pasar el mouse por una flor: crece con rebote
// y abre sus pétalos (los capullos florecen). Con un clic gira y suelta pétalos.
// Todo el ramo se mece y se inclina hacia el cursor como si hubiera viento.
---

<div class="hero-3d" aria-hidden="true">
  <canvas id="hero-3d"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

  const canvas = document.getElementById('hero-3d') as HTMLCanvasElement;
  const hero = canvas.closest('section') as HTMLElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));
  renderer.toneMapping = THREE.NeutralToneMapping;
  renderer.toneMappingExposure = 0.95;

  const scene = new THREE.Scene();
  // Luz suave de estudio: da el acabado mate tipo plastilina
  const pmrem = new THREE.PMREMGenerator(renderer);
  scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
  const key = new THREE.DirectionalLight(0xfff1dc, 1.6);
  key.position.set(-2, 4, 5);
  scene.add(key);

  const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);
  camera.position.set(0, 0, 8.5);

  const clay = (color: number) => new THREE.MeshStandardMaterial({ color, roughness: 0.55, metalness: 0 });
  const M = {
    pink: clay(0xff5c8a),
    white: clay(0xfff4ee),
    yellow: clay(0xffbe1f),
    stamen: clay(0xf2a72e),
    green: clay(0x9aa526),
    leaf: clay(0xa3ad2c),
  };

  // ===== Geometrías base =====
  const petalGeo = new THREE.CapsuleGeometry(0.13, 0.2, 8, 16);
  petalGeo.scale(1, 1, 0.42);
  petalGeo.rotateX(Math.PI / 2);
  petalGeo.translate(0, 0, 0.27);
  const bumpGeo = new THREE.SphereGeometry(0.05, 12, 8);
  const ballGeo = new THREE.SphereGeometry(1, 32, 16);
  const stamenGeo = new THREE.CylinderGeometry(0.012, 0.012, 0.3, 6);
  stamenGeo.translate(0, 0.15, 0);
  const tipGeo = new THREE.SphereGeometry(0.035, 10, 8);

  type Kind = 'daisy' | 'cup' | 'bud' | 'ball' | 'leaf';
  interface Plant {
    root: THREE.Group; // gira desde la base del tallo (viento)
    head: THREE.Group; // orientación de la flor
    spin: THREE.Group; // giro de la flor sobre sí misma
    petals: THREE.Object3D[];
    closed: number; // inclinación de pétalos en reposo
    open: number; // inclinación al pasar el mouse
    tilt: number;
    scale: number;
    scaleVel: number;
    spinVel: number;
    hover: number;
    phase: number;
    kind: Kind;
  }

  const plants: Plant[] = [];
  const pickables: THREE.Object3D[] = [];

  const addPetals = (spin: THREE.Group, count: number, mat: THREE.Material, size: number) => {
    const petals: THREE.Object3D[] = [];
    for (let i = 0; i < count; i++) {
      const pivot = new THREE.Group();
      pivot.rotation.y = (i / count) * Math.PI * 2 + (i % 2) * 0.05;
      const petal = new THREE.Mesh(petalGeo, mat);
      petal.scale.setScalar(size);
      pivot.add(petal);
      spin.add(pivot);
      petals.push(petal);
    }
    return petals;
  };

  const addStamens = (spin: THREE.Group, count: number, len: number) => {
    for (let i = 0; i < count; i++) {
      const s = new THREE.Group();
      const a = (i / count) * Math.PI * 2;
      s.rotation.set(Math.cos(a) * 0.35, 0, Math.sin(a) * 0.35);
      const stalk = new THREE.Mesh(stamenGeo, M.stamen);
      stalk.scale.y = len;
      const tip = new THREE.Mesh(tipGeo, M.stamen);
      tip.position.y = 0.3 * len;
      s.add(stalk, tip);
      spin.add(s);
    }
  };

  const makePlant = (o: { base: [number, number]; head: [number, number, number]; face: [number, number, number]; kind: Kind; color?: keyof typeof M; size?: number; bend?: number }) => {
    const root = new THREE.Group();
    root.position.set(o.base[0], -3.8, o.base[1]);
    scene.add(root);

    const h = new THREE.Vector3(...o.head).sub(root.position);
    const bend = o.bend ?? 0.3;
    const curve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(0, 0, 0),
      new THREE.Vector3(h.x * 0.15 + bend, h.y * 0.4, h.z * 0.3),
      new THREE.Vector3(h.x * 0.75 - bend * 0.3, h.y * 0.82, h.z * 0.8),
      h.clone(),
    ]);
    root.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 48, 0.035, 8), M.green));

    const head = new THREE.Group();
    head.position.copy(h);
    head.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), new THREE.Vector3(...o.face).normalize());
    const spin = new THREE.Group();
    head.add(spin);
    root.add(head);

    const size = o.size ?? 1;
    const mat = M[o.color ?? 'pink'];
    let petals: THREE.Object3D[] = [];
    let closed = 0;
    let open = 0;

    if (o.kind === 'daisy') {
      petals = addPetals(spin, 8, mat, 1.15);
      closed = 0.15;
      open = -0.08;
      const center = new THREE.Mesh(ballGeo, M.yellow);
      center.scale.set(0.2, 0.08, 0.2);
      center.position.y = 0.06;
      spin.add(center);
      for (let i = 0; i < 16; i++) {
        const b = new THREE.Mesh(bumpGeo, M.yellow);
        const a = (i / 16) * Math.PI * 2;
        b.position.set(Math.cos(a) * 0.2, 0.07, Math.sin(a) * 0.2);
        spin.add(b);
      }
    } else if (o.kind === 'cup') {
      petals = addPetals(spin, 7, mat, 1);
      closed = 0.75;
      open = 0.2;
      const center = new THREE.Mesh(ballGeo, M.yellow);
      center.scale.set(0.13, 0.09, 0.13);
      center.position.y = 0.05;
      spin.add(center);
      addStamens(spin, 4, 1);
    } else if (o.kind === 'bud') {
      petals = addPetals(spin, 6, mat, 1);
      closed = 1.4;
      open = 0.35;
      addStamens(spin, 3, 0.8);
    } else if (o.kind === 'ball') {
      const ball = new THREE.Mesh(ballGeo, M.yellow);
      ball.scale.setScalar(0.24);
      ball.position.y = 0.2;
      const sepal = new THREE.Mesh(new THREE.SphereGeometry(0.21, 24, 12, 0, Math.PI * 2, Math.PI / 2, Math.PI / 2), M.green);
      sepal.position.y = 0.12;
      spin.add(ball, sepal);
    } else {
      const leaf = new THREE.Mesh(ballGeo, M.leaf);
      leaf.scale.set(0.32, 0.045, 0.55);
      leaf.position.z = 0.45;
      spin.add(leaf);
    }

    head.scale.setScalar(size);
    const plant: Plant = { root, head, spin, petals, closed, open, tilt: closed, scale: size, scaleVel: 0, spinVel: 0, hover: 0, phase: Math.random() * 6, kind: o.kind };
    head.traverse((m) => {
      if ((m as THREE.Mesh).isMesh) {
        m.userData.plant = plant;
        pickables.push(m);
      }
    });
    head.userData.size = size;
    plants.push(plant);
  };

  // ===== El ramo =====
  makePlant({ kind: 'daisy', base: [-0.2, 0], head: [-0.7, 1.35, 0], face: [0.1, 0.3, 1], size: 1.25, bend: 0.25 });
  makePlant({ kind: 'cup', color: 'white', base: [0.3, -0.4], head: [1.25, 1.55, -0.4], face: [0.7, 0.55, 0.6], size: 0.9, bend: -0.2 });
  makePlant({ kind: 'cup', color: 'white', base: [-0.5, 0.2], head: [-1.7, 0.35, 0.2], face: [-0.6, 0.55, 0.8], size: 0.85, bend: 0.35 });
  makePlant({ kind: 'daisy', base: [0.1, 0.3], head: [0.45, 0.05, 0.4], face: [0.05, 0.4, 1], size: 1.1, bend: -0.3 });
  makePlant({ kind: 'ball', base: [0.5, 0], head: [1.8, 0.2, 0.1], face: [0.4, 1, 0.2], size: 1, bend: -0.4 });
  makePlant({ kind: 'bud', color: 'pink', base: [-0.3, 0.5], head: [-0.65, -1.05, 0.7], face: [-0.25, 1, 0.5], size: 1, bend: 0.2 });
  makePlant({ kind: 'bud', color: 'white', base: [0.3, 0.5], head: [1.05, -1.3, 0.6], face: [0.15, 1, 0.35], size: 0.95, bend: -0.15 });
  makePlant({ kind: 'leaf', base: [-0.4, 0.3], head: [-1.75, -0.85, 0.4], face: [-0.6, 0.5, 0.8], size: 1.2, bend: 0.4 });

  // ===== Pétalos que salen volando al hacer clic =====
  const flying: { mesh: THREE.Mesh; vel: THREE.Vector3; life: number }[] = [];
  const burst = (p: Plant) => {
    const origin = p.head.getWorldPosition(new THREE.Vector3());
    const base = (p.petals[0] as THREE.Mesh | undefined)?.material as THREE.MeshStandardMaterial | undefined;
    for (let i = 0; i < 7; i++) {
      const mat = (base ?? M.yellow).clone();
      mat.transparent = true;
      const mesh = new THREE.Mesh(petalGeo, mat);
      mesh.scale.setScalar(0.55);
      mesh.position.copy(origin);
      mesh.rotation.set(Math.random() * 6, Math.random() * 6, Math.random() * 6);
      scene.add(mesh);
      const a = Math.random() * Math.PI * 2;
      flying.push({ mesh, vel: new THREE.Vector3(Math.cos(a) * 1.4, 1.2 + Math.random(), Math.sin(a) * 0.8), life: 1 });
    }
  };

  // ===== Interacción =====
  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2(0, 0);
  let inside = false;
  let hovered: Plant | null = null;

  const pick = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    pointer.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
    raycaster.setFromCamera(pointer, camera);
    const hit = raycaster.intersectObjects(pickables, false)[0];
    hovered = hit ? (hit.object.userData.plant as Plant) : null;
    hero.style.cursor = hovered ? 'pointer' : '';
  };
  const isUI = (e: Event) => !!(e.target as HTMLElement).closest('a, button, .player');

  hero.addEventListener('pointermove', (e) => {
    inside = true;
    pick(e);
  });
  hero.addEventListener('pointerleave', () => {
    inside = false;
    hovered = null;
    hero.style.cursor = '';
  });
  hero.addEventListener('click', (e) => {
    if (isUI(e)) return;
    pick(e as PointerEvent);
    if (!hovered) return;
    hovered.spinVel = 0.5;
    hovered.scaleVel += 0.08;
    burst(hovered);
  });

  // ===== Animación =====
  const resize = () => {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  };

  let last = performance.now();
  let time = 0;
  let lean = 0;
  let visible = true;
  let raf = 0;

  const frame = () => {
    const now = performance.now();
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    time += dt * (reduced ? 0.2 : 1);

    // Viento: el ramo se inclina hacia el cursor
    lean += ((inside ? pointer.x : 0) * 0.07 - lean) * 0.04;

    plants.forEach((p) => {
      p.root.rotation.z = Math.sin(time * 0.9 + p.phase) * 0.018 - lean;
      p.root.rotation.x = Math.sin(time * 0.7 + p.phase * 2) * 0.012;

      p.hover += ((p === hovered ? 1 : 0) - p.hover) * 0.1;

      // Escala con resorte: crece con rebote al pasar el mouse
      const target = p.head.userData.size * (1 + p.hover * 0.18);
      p.scaleVel += (target - p.scale) * 0.12;
      p.scaleVel *= 0.78;
      p.scale += p.scaleVel;
      p.head.scale.setScalar(p.scale);

      // Pétalos: se abren (y los capullos florecen); respiran un poco al estar abiertos
      const goal = p.closed + (p.open - p.closed) * p.hover + Math.sin(time * 4 + p.phase) * 0.05 * p.hover;
      p.tilt += (goal - p.tilt) * 0.12;
      p.petals.forEach((petal) => (petal.rotation.x = -p.tilt));

      p.spinVel *= 0.95;
      p.spin.rotation.y += p.spinVel + p.hover * 0.01;
      if (p.kind === 'leaf' || p.kind === 'ball') p.spin.rotation.z = Math.sin(time * 6) * 0.08 * p.hover;
    });

    for (let i = flying.length - 1; i >= 0; i--) {
      const f = flying[i];
      f.life -= dt * 0.7;
      f.vel.y -= dt * 1.2;
      f.vel.multiplyScalar(0.985);
      f.mesh.position.addScaledVector(f.vel, dt);
      f.mesh.rotation.x += dt * 3;
      f.mesh.rotation.z += dt * 2;
      (f.mesh.material as THREE.MeshStandardMaterial).opacity = Math.max(f.life, 0);
      if (f.life <= 0) {
        scene.remove(f.mesh);
        (f.mesh.material as THREE.Material).dispose();
        flying.splice(i, 1);
      }
    }

    renderer.render(scene, camera);
    if (visible) raf = requestAnimationFrame(frame);
  };

  resize();
  addEventListener('resize', resize);
  canvas.classList.add('ready');
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    cancelAnimationFrame(raf);
    if (visible) {
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }
  }).observe(canvas);
</script>

<style>
  .hero-3d {
    position: absolute;
    top: 0;
    right: 0;
    width: 55%;
    height: 100%;
    pointer-events: none;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1.2s, transform 1.4s var(--ease);
  }
  canvas.ready {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 760px) {
    .hero-3d {
      width: 100%;
      height: 55%;
      top: auto;
      bottom: 0;
      opacity: 0.75;
    }
  }
</style>
