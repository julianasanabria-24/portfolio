---
import { url } from '../lib/url';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="cover" style={`--c:${project.color}`}>
  {
    project.image ? (
      <img src={url(project.image)} alt="" loading="lazy" decoding="async" />
    ) : (
      <span class="initial" aria-hidden="true">
        {project.title.charAt(0)}
      </span>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: radial-gradient(circle at 75% 25%, rgba(255, 255, 255, 0.6), transparent 40%),
      repeating-linear-gradient(-45deg, transparent 0 18px, rgba(20, 33, 61, 0.05) 18px 20px), var(--c);
    border: 2px solid var(--navy);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .initial {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 9rem);
    color: var(--navy);
    transition: transform 0.6s var(--ease);
  }
  :global(a:hover) > .cover img,
  :global(a:hover) > .cover .initial {
    transform: scale(1.06) rotate(-2deg);
  }
</style>
