---
const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
];
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Principal">
    <ul class="links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <button class="btn btn--gold" data-open-contact>Work with me</button>
  </nav>

  <!-- Modo día/noche, separado en la esquina -->
  <button class="icon-btn theme" id="theme-toggle" aria-label="Cambiar modo día/noche">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><g stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></g></svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
  </button>
</header>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    window.dispatchEvent(new CustomEvent('themechange'));
  });
</script>

<style>
  .nav-wrap {
    position: fixed;
    inset: 1rem 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid var(--line);
    box-shadow: 0 8px 30px rgba(20, 33, 61, 0.08);
  }
  .links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }
  .links a:hover {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }
  .nav .btn {
    padding: 0.6rem 1.2rem;
  }
  .icon-btn {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 30px rgba(20, 33, 61, 0.08);
    color: var(--fg);
    cursor: pointer;
  }
  .theme {
    pointer-events: auto;
    position: absolute;
    top: 0;
    right: var(--gutter);
  }
  .icon-btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    stroke: currentColor;
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }

  @media (max-width: 560px) {
    .nav-wrap {
      justify-content: flex-start;
    }
    .links a {
      padding: 0.5rem 0.7rem;
    }
    .nav .btn {
      padding: 0.55rem 0.9rem;
      font-size: 0.9rem;
    }
    .icon-btn {
      width: 44px;
      height: 44px;
    }
  }
</style>
